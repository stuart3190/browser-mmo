# Copy to .env and adjust. Never commit .env. Secrets have no defaults in code.

NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL 16+ (local install; Docker is optional, see docs/architecture/local-development.md)
DATABASE_URL=postgres://mmo:mmo@localhost:5432/mmo_dev
DATABASE_POOL_MAX=10
# Used only by integration tests. Tests DROP and recreate its schema — never point at real data.
TEST_DATABASE_URL=postgres://mmo:mmo@localhost:5432/mmo_test

# API service
API_HOST=127.0.0.1
API_PORT=4000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
SESSION_TTL_HOURS=168
# Dev-only username login. The API refuses to start with this enabled when NODE_ENV=production.
AUTH_DEV_LOGIN_ENABLED=true
# Required in production. Accounts are provisioned by an operator; no public signup.
AUTH_PASSWORD_LOGIN_ENABLED=false
AUTH_DEV_ADMIN_USERNAMES=admin

# Realtime service
REALTIME_HOST=127.0.0.1
REALTIME_PORT=4001
REALTIME_ALLOWED_ORIGINS=http://localhost:5173
REALTIME_TICK_HZ=20
# Conservative pilot ceiling; raise only after intended-host workload validation.
REALTIME_MAX_CONNECTIONS=5
REALTIME_ZONES=zone.greenvale.meadows

# Browser apps (Vite exposes only VITE_* variables to the client)
VITE_API_URL=http://localhost:4000
VITE_REALTIME_URL=ws://localhost:4001

# Enable only with the supplied loopback TLS ingress, which overwrites forwarding headers.
TRUST_PROXY_LOOPBACK=false
