{
  "name": "@mmo/db",
  "version": "0.0.0",
  "private": true,
  "description": "PostgreSQL schema (Drizzle ORM), SQL migrations, client factory and seed data.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:reset": "tsx scripts/reset.ts && tsx scripts/migrate.ts",
    "db:sync-content": "tsx scripts/sync-content.ts"
  },
  "dependencies": {
    "@mmo/config": "workspace:*",
    "@mmo/game-data": "workspace:*",
    "@mmo/schemas": "workspace:*",
    "@mmo/shared": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"
  }
}
