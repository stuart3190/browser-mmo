{
  "name": "@mmo/api",
  "version": "0.0.0",
  "private": true,
  "description": "HTTP API (Fastify): auth, characters, inventory, marketplace, admin. Client-agnostic: serves the browser game, admin app and future mobile app.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "start": "node dist/main.js",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test:integration": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@mmo/config": "workspace:*",
    "@mmo/db": "workspace:*",
    "@mmo/domain": "workspace:*",
    "@mmo/game-data": "workspace:*",
    "@mmo/schemas": "workspace:*",
    "@mmo/server-kit": "workspace:*",
    "@mmo/shared": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^8.5.1"
  }
}
